    // Bulk courier status sync
    $(document).on('click', '.multi_order_courier_sync', function(e){
        e.preventDefault();
        var btn = $(this);
        var order_ids = $('input.checkbox:checked').map(function() {
            return $(this).val();
        }).get();
        
        if(order_ids.length == 0){
            toastr.error('Please select at least one order to sync!');
            return;
        }

        btn.prop('disabled', true).html('<i class="fe-refresh-cw fa-spin"></i> Syncing...');
        
        $.ajax({
           type: 'POST',
           url: "{{ route('admin.order.bulk_courier_sync') }}",
           data: {
               _token: "{{ csrf_token() }}",
               order_ids: order_ids
           },
           success: function(res){
               btn.prop('disabled', false).html('<i class="fe-refresh-cw"></i> Sync Courier Status');
               if(res.status === 'success'){
                    toastr.success(res.message);
                    table.ajax.reload(null, false);
                } else {
                    toastr.error(res.message || 'Failed to sync status');
                }
           },
           error: function(xhr){
               btn.prop('disabled', false).html('<i class="fe-refresh-cw"></i> Sync Courier Status');
               var msg = xhr.responseJSON ? xhr.responseJSON.message : 'Something went wrong during sync';
               toastr.error(msg);
           }
        });
    });

    // Single order courier status sync (1-click from table row)
    $(document).on('click', '.btn-sync-courier', function(e){
        e.preventDefault();
        var btn = $(this);
        var orderId = btn.data('order-id');
        var icon = btn.find('i');

        icon.addClass('fa-spin');
        btn.prop('disabled', true);

        $.ajax({
            type: 'GET',
            url: "{{ url('admin/order/courier-status') }}/" + orderId,
            success: function(res){
                icon.removeClass('fa-spin');
                btn.prop('disabled', false);
                if(res.status === 'success'){
                    toastr.success('Courier Status: ' + res.delivery_status);
                    table.ajax.reload(null, false);
                } else {
                    toastr.error(res.message || 'Could not fetch status');
                }
            },
            error: function(xhr){
                icon.removeClass('fa-spin');
                btn.prop('disabled', false);
                var msg = xhr.responseJSON ? xhr.responseJSON.message : 'Error syncing courier status';
                toastr.error(msg);
            }
        });
    });

    // Pathao Courier
    $(document).on('submit', 'form#order_sendto_pathao', function(e){
        e.preventDefault();
        var url = $(this).attr('action');
        var order_ids = $('input.checkbox:checked').map(function() {
            return $(this).val();
        }).get();
        
        if(order_ids.length == 0){
            toastr.error('Please Select An Order First !');
            return;
        }

        var store_id = $('#pathaostore').val();
        var city_id = $('#pathaocity').val();
        var zone_id = $('#pathaozone').val();
        var area_id = $('#pathaoarea').val();

        if (!store_id || !city_id || !zone_id || !area_id) {
            toastr.error('Please fill out all required fields!');
            return;
        }
        
        $.ajax({
           type:'GET',
           url: url,
           data: {
                order_ids: order_ids,
                store_id: store_id,
                city_id: city_id,
                zone_id: zone_id,
                area_id: area_id,
            },
           success:function(res){
               if(res.status=='success'){
                    toastr.success(res.message);
                    $('#pathao').modal('hide');
                    table.ajax.reload();
                }else{
                    toastr.error('Failed something wrong');
                }
           }
        });
    });
});
