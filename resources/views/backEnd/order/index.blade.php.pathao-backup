$('#orders_table').on('change', '.status-change', function() {
    var select = $(this);
    var orderId = select.data('order-id');
    var statusId = select.val();
    
    $.ajax({
        url: "{{ route('admin.order.update-status') }}",
        type: 'POST',
        data: {
            _token: "{{ csrf_token() }}",
            order_id: orderId,
            status_id: statusId
        },
        success: function(response) {
            if (response.success) {
                toastr.success('Status updated successfully');
            } else {
                toastr.error('Failed to update status');
                select.val(select.data('original-status')); // Revert on error
            }
            table.draw();
        },
        error: function() {
            toastr.error('Something went wrong');
        }
    });
});

