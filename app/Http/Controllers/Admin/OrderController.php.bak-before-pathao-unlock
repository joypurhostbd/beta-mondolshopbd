    public function order_process(Request $request)
    {
        $order = Order::findOrFail($request->id);
        $statusObj = OrderStatus::find($request->status);
        $link = $statusObj ? $statusObj->slug : 'all';
        $courier = (int) $order->order_status;
        $isDispatched = $order->isCourierDispatched();

        if (! $isDispatched) {
            $order->order_status = $request->status;
        }

        $order->admin_note = $request->admin_note;
        if ($request->has('note')) {
            $order->note = $request->note;
        }
        $order->save();

        $shipping_update = Shipping::where('order_id', $order->id)->first();
        $shippingfee = ShippingCharge::find($request->area);
        if ($shippingfee) {
            if ($order->shipping_charge != $shippingfee->amount) {
                $total = ($order->amount - $order->shipping_charge) + $shippingfee->amount;
                $order->shipping_charge = $shippingfee->amount;
                $order->amount = max(0, $total);
                $order->save();
            }
            if ($shipping_update) {
                $shipping_update->area = $shippingfee->name;
            }
        }

        if ($shipping_update) {
            $shipping_update->name = $request->name;
            $shipping_update->phone = $request->phone;
            $shipping_update->address = $request->address;
            $shipping_update->save();
        }

        if (! $isDispatched && $courier !== (int) $request->status) {
            $this->syncStockAndPaymentOnStatusChange($order, $courier, (int) $request->status);
        }

        $message = $isDispatched
            ? 'Order details updated. Status remained locked by courier.'
            : 'Order status change successfully';
        Toastr::success('Success', $message);

        return redirect('admin/order/'.$link);
    }

