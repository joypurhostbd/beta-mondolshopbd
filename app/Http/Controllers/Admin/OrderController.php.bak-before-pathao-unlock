    public function index($slug, Request $request)
    {
        $all_statuses = OrderStatus::where('status', 1)->withCount('orders')->orderBy('id', 'asc')->get();

        // Accurately calculate order counts for courier filter tabs with single query
        $courierCounts = Order::getCourierCounts();
        foreach ($all_statuses as $st) {
            if (Order::isCourierFilterSlug($st->slug)) {
                $st->orders_count = $courierCounts[$st->slug] ?? 0;
            }
        }

        $total_all_orders = Order::count();
        $active_orders_query = Order::filterByStatusSlug($slug);

        if ($slug == 'all') {
            $order_status = (object) [
                'name' => 'All',
                'orders_count' => $total_all_orders,
            ];
        } elseif (Order::isCourierFilterSlug($slug)) {
            $order_status = (object) [
                'name' => Order::getCourierFilterName($slug),
                'orders_count' => (clone $active_orders_query)->count(),
            ];
        } else {
            $order_status = OrderStatus::where('slug', $slug)->withCount('orders')->first();
            if (! $order_status) {
                $order_status = (object) [
                    'name' => ucfirst(str_replace('-', ' ', $slug)),
                    'orders_count' => 0,
                ];
            }
        }

        $status_total_amount = (clone $active_orders_query)->sum('amount') ?? 0;
        $status_dispatched_count = (clone $active_orders_query)->where(function ($q) {
            $q->whereNotNull('consignment_id')->where('consignment_id', '!=', '')
                ->orWhereNotNull('tracking_code')->where('tracking_code', '!=', '');
        })->count();
        $status_today_count = (clone $active_orders_query)->where('created_at', '>=', Carbon::today())->count();

        $users = User::get();
        $steadfast = Courierapi::where(['status' => 1, 'type' => 'steadfast'])->first();
        $pathao_info = Courierapi::where(['status' => 1, 'type' => 'pathao'])->select('id', 'type', 'url', 'token', 'status')->first();

        // Pathao courier data
        $pathaocities = [];
        $pathaostore = [];
        if ($pathao_info) {
            $headers = [
                'Authorization' => 'Bearer '.$pathao_info->token,
                'Content-Type' => 'application/json',
                'Accept' => 'application/json',
            ];
            try {
                $response = Http::withHeaders($headers)->get($pathao_info->url.'/aladdin/api/v1/city-list');
                $pathaocities = $response->json();
                $response2 = Http::withHeaders($headers)->get($pathao_info->url.'/aladdin/api/v1/stores');
                $pathaostore = $response2->json();
            } catch (\Exception $e) {
                // Silently fallback on API network issues
            }
        }

        return view('backEnd.order.index', compact(
            'order_status',
            'users',
            'steadfast',
            'pathaostore',
            'pathaocities',
            'slug',
            'all_statuses',
            'total_all_orders',
            'status_total_amount',
            'status_dispatched_count',
            'status_today_count'
        ));
    }

