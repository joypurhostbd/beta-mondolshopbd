    public function bulk_courier($slug, Request $request)
    {
        $courier_info = Courierapi::where(['status' => 1, 'type' => $slug])->first();
        if (! $courier_info) {
            return response()->json(['status' => 'failed', 'message' => 'Courier API configuration not found or inactive'], 404);
        }

        $orders_id = (array) $request->input('order_ids', []);
        if (empty($orders_id)) {
            return response()->json(['status' => 'failed', 'message' => 'No orders selected'], 422);
        }

        $successCount = 0;
        $failedCount = 0;
        $steadfastService = ($slug === 'steadfast') ? app(SteadfastCourierService::class) : null;
        $client = ($slug !== 'steadfast') ? new Client : null;

        foreach ($orders_id as $order_id) {
            $order = Order::with('shipping')->find($order_id);
            if (! $order || (int) $order->order_status === (int) OrderStatusEnum::Delivered->value) {
                continue;
            }

            $recipientName = $order->shipping ? $order->shipping->name : 'Customer';
            $recipientPhone = $order->shipping ? $order->shipping->phone : '01700000000';
            $recipientAddress = $order->shipping ? $order->shipping->address : 'Dhaka';
            $orderNote = ! empty($order->note) ? $order->note : (! empty($order->admin_note) ? $order->admin_note : '');

            $consignmentData = [
                'invoice' => $order->invoice_id,
                'recipient_name' => $recipientName,
                'recipient_phone' => $recipientPhone,
                'recipient_address' => $recipientAddress,
                'cod_amount' => (float) $order->amount,
                'note' => $orderNote,
            ];

            try {
                if ($slug === 'steadfast' && $steadfastService) {
                    $responseData = $steadfastService->placeOrder($consignmentData);
                } else {
                    $response = $client->post(rtrim($courier_info->url, '/').'/create_order', [
                        'json' => $consignmentData,
                        'headers' => [
                            'Api-Key' => $courier_info->api_key,
                            'Secret-Key' => $courier_info->secret_key,
                            'Accept' => 'application/json',
                        ],
                        'timeout' => 15,
                    ]);
                    $responseData = json_decode($response->getBody(), true);
                }

                if (isset($responseData['status']) && (int) $responseData['status'] === 200) {
                    $courierStatusId = OrderStatus::whereIn('slug', ['in-courier', 'shipped', 'on-the-way'])->value('id') ?? OrderStatusEnum::Shipped->value;
                    $order->order_status = $courierStatusId;
                    $order->courier_name = 'steadfast';
                    $order->courier_status = 'pending';
                    if (isset($responseData['consignment']['consignment_id'])) {
                        $order->consignment_id = (string) $responseData['consignment']['consignment_id'];
                    }
                    if (isset($responseData['consignment']['tracking_code'])) {
                        $order->tracking_code = (string) $responseData['consignment']['tracking_code'];
                    } elseif (isset($responseData['consignment']['consignment_id']) && empty($order->tracking_code)) {
                        $order->tracking_code = (string) $responseData['consignment']['consignment_id'];
                    }
                    $order->save();
                    $successCount++;
                } else {
                    $failedCount++;
                }
            } catch (\Exception $e) {
                $failedCount++;
            }
        }

        $status = $successCount > 0 ? 'success' : 'failed';
        $message = $successCount > 0
            ? "Successfully dispatched {$successCount} order(s) to {$slug}.".($failedCount > 0 ? " ({$failedCount} failed)" : '')
            : "Failed to dispatch orders to {$slug}.";

        return response()->json([
            'status' => $status,
            'message' => $message,
            'success_count' => $successCount,
            'failed_count' => $failedCount,
        ]);
    }

