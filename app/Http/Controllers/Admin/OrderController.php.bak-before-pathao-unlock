    public function order_update(AdminOrderUpdateRequest $request)
    {
        if (CartService::instance('pos_shopping')->count() <= 0) {
            Toastr::error('Your shopping cart is empty', 'Failed!');

            return redirect()->back();
        }

        $order = Order::where('id', $request->order_id)->firstOrFail();
        $oldStatus = (int) $order->order_status;
        $newStatus = $oldStatus;

        try {
            DB::transaction(function () use ($request, $order, $oldStatus, &$newStatus) {
                $subtotalRaw = CartService::instance('pos_shopping')->subtotal();
                $subtotal = (float) str_replace(',', '', $subtotalRaw);
                $itemDiscount = (float) (Session::get('pos_discount', 0) + Session::get('product_discount', 0));
                $orderDiscount = $request->filled('order_discount') ? (float) $request->order_discount : 0;
                $totalDiscount = $itemDiscount + $orderDiscount;
                $advanceAmount = $request->filled('advance_amount') ? (float) $request->advance_amount : 0;

                $shippingfee = ShippingCharge::find($request->area);
                if (! $shippingfee) {
                    $shippingfee = ShippingCharge::where('status', 1)->first();
                }
                $customShipping = $request->filled('custom_shipping') ? (float) $request->custom_shipping : null;
                $shippingAmount = $customShipping !== null ? $customShipping : ($shippingfee ? (float) $shippingfee->amount : (float) $order->shipping_charge);
                $shippingAreaName = $shippingfee ? $shippingfee->name : ($order->shipping?->area ?? 'Standard Delivery');

                // Find or create customer with normalized phone
                $cleanPhone = Phone::normalize($request->phone);
                $exits_customer = Customer::where('phone', $cleanPhone)->orWhere('phone', $request->phone)->select('phone', 'id')->first();
                if ($exits_customer) {
                    $customer_id = $exits_customer->id;
                } else {
                    $autoPassword = (string) rand(111111, 999999);
                    $store = new Customer;
                    $store->name = $request->name;
                    $store->slug = Str::slug($request->name).'-'.rand(100, 999);
                    $store->phone = $cleanPhone ?: $request->phone;
                    $store->password = bcrypt($autoPassword);
                    $store->verify = 1;
                    $store->status = 1;
                    $store->save();
                    $customer_id = $store->id;
                    SmsGateway::sendAutoGeneratedPasswordSms($store, $autoPassword);
                }

                // Order data save
                if (empty($order->invoice_id)) {
                    $order->invoice_id = rand(11111, 99999);
                }
                $netPayable = max(0, ($subtotal + $shippingAmount) - $totalDiscount - $advanceAmount);
                $order->amount = $netPayable;
                $order->discount = $totalDiscount > 0 ? $totalDiscount : 0;
                $order->shipping_charge = $shippingAmount;
                $order->customer_id = $customer_id;

                // Only allow status update if not courier-locked and not a courier status
                if ($request->filled('order_status')) {
                    $requestedStatus = (int) $request->order_status;
                    $courierStatusIds = OrderStatus::whereIn('slug', Order::getCourierFilterSlugs())->pluck('id')->toArray();
                    if (! in_array($requestedStatus, $courierStatusIds, true)) {
                        if (! $order->isCourierLocked() || $requestedStatus === $oldStatus) {
                            $order->order_status = $requestedStatus;
                            $newStatus = $requestedStatus;
                        }
                    }
                }

                if ($request->has('admin_note')) {
                    $order->admin_note = $request->admin_note;
                }
                if ($request->has('note')) {
                    $order->note = $request->note;
                }
                $order->save();

                // Shipping data save (null-safe)
                $shipping = Shipping::firstOrNew(['order_id' => $order->id]);
                $shipping->customer_id = $customer_id;
                $shipping->name = $request->name;
                $shipping->phone = $cleanPhone ?: $request->phone;
                $shipping->address = $request->address;
                $shipping->area = $shippingAreaName;
                $shipping->save();

                // Payment data save (null-safe)
                $payment = Payment::firstOrNew(['order_id' => $order->id]);
                $payment->customer_id = $customer_id;
                $payment->payment_method = $request->filled('payment_method') ? $request->payment_method : ($payment->payment_method ?: 'Cash On Delivery');
                $payment->payment_status = $request->filled('payment_status') ? $request->payment_status : ($payment->payment_status ?: PaymentStatusEnum::Pending->value);
                if ($request->filled('trx_id')) {
                    $payment->trx_id = $request->trx_id;
                }
                if ($request->filled('sender_number')) {
                    $payment->sender_number = $request->sender_number;
                }
                $payment->amount = $advanceAmount > 0 ? $advanceAmount : $order->amount;
                $payment->save();

                $order->payment_status = $payment->payment_status;
                $order->save();

                // Order details data save (safely handling new, modified and removed items)
                static $hasProductImageCol = null;
                if ($hasProductImageCol === null) {
                    $hasProductImageCol = Schema::hasColumn('order_details', 'product_image');
                }

                $retainedDetailIds = [];
                foreach (CartService::instance('pos_shopping')->content() as $cart) {
                    $detailsId = $cart->options->details_id ?? null;
                    $orderDetail = $detailsId ? OrderDetails::where('id', $detailsId)->where('order_id', $order->id)->first() : null;
                    if (! $orderDetail) {
                        $orderDetail = new OrderDetails;
                        $orderDetail->order_id = $order->id;
                        $orderDetail->product_id = $cart->id;
                        $orderDetail->product_name = $cart->name;
                    }
                    $orderDetail->purchase_price = $cart->options->purchase_price ?? 0;
                    $orderDetail->product_discount = $cart->options->product_discount ?? 0;
                    $orderDetail->product_size = $cart->options->product_size ?? null;
                    $orderDetail->product_color = $cart->options->product_color ?? null;
                    if ($hasProductImageCol) {
                        $orderDetail->product_image = $cart->options->image ?? null;
                    }
                    $orderDetail->sale_price = $cart->price;
                    $orderDetail->qty = $cart->qty;
                    $orderDetail->save();

                    $retainedDetailIds[] = $orderDetail->id;
                }

                // Clean up any removed order details
                if (! empty($retainedDetailIds)) {
                    OrderDetails::where('order_id', $order->id)->whereNotIn('id', $retainedDetailIds)->delete();
                }

                // Sync stock and payment if status changed
                if ($oldStatus !== $newStatus) {
                    $this->syncStockAndPaymentOnStatusChange($order, $oldStatus, $newStatus);
                }
            });

            CartService::instance('pos_shopping')->destroy();
            Session::forget('pos_shipping');
            Session::forget('pos_discount');
            Session::forget('product_discount');

            Toastr::success('Order updated successfully', 'Success!');

            $statusSlug = $order->fresh()->status ? $order->fresh()->status->slug : 'all';

            return redirect()->route('admin.orders', $statusSlug);
        } catch (\Throwable $e) {
            Log::error('Order update failed: '.$e->getMessage(), [
                'order_id' => $request->order_id,
                'file' => $e->getFile(),
                'line' => $e->getLine(),
                'trace' => $e->getTraceAsString(),
            ]);

            Toastr::error('Failed to update order: '.$e->getMessage(), 'Error!');

            return redirect()->back()->withInput();
        }
    }
}
