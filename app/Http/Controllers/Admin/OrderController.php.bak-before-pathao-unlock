    public function refresh_fraud_score($order_id, Request $request, FraudCheckService $fraudService)
    {
        $order = Order::with(['shipping', 'customer'])->findOrFail($order_id);
        $phone = $order->shipping?->phone ?? $order->customer?->phone ?? null;

        if (empty($phone)) {
            return response()->json([
                'status' => 'error',
                'message' => 'No phone number found for this order.',
            ], 422);
        }

        $force = filter_var($request->input('force', true), FILTER_VALIDATE_BOOLEAN);
        $result = $fraudService->check($phone, $force);

        if ($result['status'] === 'success' && isset($result['total_stats']['delivery_rate'])) {
            $stats = $result['total_stats'];
            $rate = (float) $stats['delivery_rate'];
            $order->f_check = $rate;
            $order->fraud_report = [
                'total_parcel' => (int) ($stats['total_parcel'] ?? 0),
                'total_delivered' => (int) ($stats['total_delivered'] ?? 0),
                'total_cancel' => (int) ($stats['total_cancel'] ?? 0),
                'delivery_rate' => $rate,
                'courier_breakdown' => $result['courier_breakdown'] ?? [],
                'summaries' => $result['individual_response']['Summaries'] ?? [],
            ];
            $order->save();

            $badgeClass = (int) $rate >= 80 ? 'bg-success' : ((int) $rate >= 50 ? 'bg-warning' : 'bg-danger');

            return response()->json([
                'status' => 'success',
                'delivery_rate' => $rate,
                'formatted_rate' => (int) round($rate) . '%',
                'badge_class' => $badgeClass,
                'stats' => $result['total_stats'],
                'courier_breakdown' => $result['courier_breakdown'] ?? [],
                'total_orders' => (int) ($result['total_stats']['total_parcel'] ?? 0),
                'total_delivered' => (int) ($result['total_stats']['total_delivered'] ?? 0),
                'total_cancel' => (int) ($result['total_stats']['total_cancel'] ?? 0),
                'message' => "Updated Delivery Success: {$rate}% ({$result['total_stats']['total_delivered']} delivered / {$result['total_stats']['total_parcel']} parcels)",
            ]);
        }

        return response()->json([
            'status' => 'error',
            'message' => $result['error'] ?? 'Could not fetch courier delivery stats from API.',
        ], 400);
    }

    public function bulk_courier_sync(Request $request, SyncCourierOrderStatusAction $syncAction)
    {
        $orderIds = $request->input('order_ids', []);
        if (empty($orderIds)) {
            return response()->json(['status' => 'failed', 'message' => 'Please select at least one order to sync.'], 400);
        }

        $orders = Order::whereIn('id', $orderIds)
            ->where(function ($q) {
                $q->whereNotNull('consignment_id')->where('consignment_id', '!=', '')
                    ->orWhereNotNull('tracking_code')->where('tracking_code', '!=', '');
            })
            ->get();

        if ($orders->isEmpty()) {
            return response()->json([
                'status' => 'failed',
                'message' => 'None of the selected orders have courier tracking details.',
            ], 400);
        }

        $successCount = 0;
        $statusChangedCount = 0;
        $failedCount = 0;

        foreach ($orders as $order) {
            try {
                $res = $syncAction->execute($order);
                if ($res['success']) {
                    $successCount++;
                    if (! empty($res['status_changed'])) {
                        $statusChangedCount++;
                    }
                } else {
                    $failedCount++;
                }
            } catch (\Throwable $e) {
                $failedCount++;
            }
        }

        $message = "Synced {$successCount} order(s) with SteadFast.";
        if ($statusChangedCount > 0) {
            $message .= " {$statusChangedCount} status(es) updated.";
        }
        if ($failedCount > 0) {
            $message .= " ({$failedCount} failed).";
        }

        return response()->json([
            'status' => $successCount > 0 ? 'success' : 'failed',
            'message' => $message,
            'success_count' => $successCount,
            'changed_count' => $statusChangedCount,
            'failed_count' => $failedCount,
        ]);
    }

