    private function syncStockAndPaymentOnStatusChange(Order $order, int $oldStatusId, int $newStatusId): void
    {
        $completedStatusIds = OrderStatus::whereIn('slug', ['completed', 'delivered'])->pluck('id')->toArray();
        $cancelledStatusIds = OrderStatus::where('slug', 'cancelled')->pluck('id')->toArray();

        $isNewCompleted = in_array($newStatusId, $completedStatusIds, true);
        $isOldCompleted = in_array($oldStatusId, $completedStatusIds, true);
        $isNewCancelled = in_array($newStatusId, $cancelledStatusIds, true);

        if ($isNewCompleted && ! $isOldCompleted) {
            $orderDetails = OrderDetails::select('id', 'order_id', 'product_id', 'qty')->where('order_id', $order->id)->get();
            foreach ($orderDetails as $detail) {
                $product = Product::find($detail->product_id);
                if ($product) {
                    $product->stock = max(0, $product->stock - (int) $detail->qty);
                    $product->save();
                }
            }

            $order->payment_status = 'paid';
            $order->save();
            Payment::where('order_id', $order->id)->update(['payment_status' => 'paid']);
        } elseif ($isNewCancelled) {
            if ($isOldCompleted) {
                $orderDetails = OrderDetails::select('id', 'order_id', 'product_id', 'qty')->where('order_id', $order->id)->get();
                foreach ($orderDetails as $detail) {
                    $product = Product::find($detail->product_id);
                    if ($product) {
                        $product->stock += (int) $detail->qty;
                        $product->save();
                    }
                }
            }

            $order->payment_status = 'cancelled';
            $order->save();
            Payment::where('order_id', $order->id)->update(['payment_status' => 'cancelled']);
        }
    }

    public function updateStatus(Request $request)
    {
        try {
            $order = Order::findOrFail($request->order_id);

            if ($order->isCourierDispatched()) {
                return response()->json([
                    'success' => false,
                    'msg' => 'Order #'.$order->invoice_id.' is dispatched to courier and cannot be changed manually.',
                ], 422);
            }

            $oldStatus = (int) $order->order_status;
            $newStatus = (int) $request->status_id;
            $order->order_status = $newStatus;
            $order->save();

            $this->syncStockAndPaymentOnStatusChange($order, $oldStatus, $newStatus);

            return response()->json(['success' => true]);
        } catch (\Exception $e) {
            return response()->json(['success' => false, 'msg' => $e->getMessage()], 500);
        }
    }

    public function incomplete()
    {
        $datas = IncompleteOrder::latest()->get();
        $total_leads = $datas->count();
        $today_leads = IncompleteOrder::where('created_at', '>=', Carbon::today())->count();
        $leads_with_phone = $datas->filter(fn ($d) => ! empty($d->phone))->count();

        $total_recoverable_amount = 0;
        foreach ($datas as $lead) {
            $items = is_string($lead->data) ? json_decode($lead->data) : (is_array($lead->data) || is_object($lead->data) ? $lead->data : []);
            if ($items) {
                foreach ($items as $item) {
                    $itemObj = (object) $item;
                    $qty = (int) ($itemObj->qty ?? 1);
                    $price = (float) ($itemObj->price ?? 0);
                    $total_recoverable_amount += ($price * $qty);
                }
            }
        }

        return view('backEnd.order.incomplete', compact('datas', 'total_leads', 'today_leads', 'leads_with_phone', 'total_recoverable_amount'));
    }

    public function incomplete_delete($id)
    {
        $datas = IncompleteOrder::find($id);
        if ($datas) {
            $datas->delete();
            Toastr::success('Incomplete order removed successfully.');
        } else {
            Toastr::error('Incomplete order not found.');
        }

        return redirect()->back();
    }

    public function incomplete_bulk_delete(Request $request)
    {
        $ids = $request->input('ids', []);
        if (is_array($ids) && count($ids) > 0) {
            IncompleteOrder::whereIn('id', $ids)->delete();
            Toastr::success(count($ids).' abandoned leads removed successfully.', 'Success');
        } else {
            Toastr::warning('No leads were selected for deletion.', 'Notice');
        }

        return redirect()->back();
    }

    public function incomplete_convert($id)
    {
        $incomplete = IncompleteOrder::findOrFail($id);

        $phone = Phone::normalize($incomplete->phone);
        if (empty($phone)) {
            Toastr::warning('Customer phone number is missing or invalid. Please update phone before converting.', 'Phone Required');

            return redirect()->back();
        }

        $cartItems = is_array($incomplete->data) ? $incomplete->data : json_decode($incomplete->data, true);
        if (empty($cartItems)) {
            $cartItems = json_decode($incomplete->data);
        }

        if (empty($cartItems)) {
            Toastr::error('No items found in this incomplete order.', 'Error');

            return redirect()->back();
        }

        $subtotal = 0;
        foreach ($cartItems as $item) {
            $itemArr = (array) $item;
            $subtotal += ((float) ($itemArr['price'] ?? 0) * (int) ($itemArr['qty'] ?? 1));
        }

        $shippingRecord = ShippingCharge::where('status', 1)->first();
        $shippingCharge = $shippingRecord ? (float) $shippingRecord->amount : 100.0;
        $totalAmount = $subtotal + $shippingCharge;

        try {
            $order = DB::transaction(function () use ($incomplete, $phone, $cartItems, $subtotal, $shippingCharge, $totalAmount, $shippingRecord) {
                $customer = Customer::where('phone', $phone)->first();
                if (! $customer) {
                    $autoPassword = (string) rand(111111, 999999);
                    $customer = Customer::create([
                        'name' => $incomplete->name ?? 'Guest Buyer',
                        'slug' => Str::slug($incomplete->name ?? 'guest-buyer').'-'.rand(100, 999),
                        'phone' => $phone,
                        'password' => bcrypt($autoPassword),
                        'verify' => 1,
                        'status' => 1,
                    ]);
                    SmsGateway::sendAutoGeneratedPasswordSms($customer, $autoPassword);
                }

                $order = new Order;
                $order->invoice_id = rand(11111, 99999);
                $order->amount = $totalAmount;
                $order->discount = 0;
                $order->shipping_charge = $shippingCharge;
                $order->customer_id = $customer->id;
                $order->order_status = 1; // Pending
                $order->note = 'Converted from Abandoned Cart Lead #'.$incomplete->id;
                $order->save();

                foreach ($cartItems as $item) {
                    $itemArr = (array) $item;
                    $options = isset($itemArr['options']) ? (array) $itemArr['options'] : [];
                    $imagePath = $options['image'] ?? null;
                    if (! $imagePath && ! empty($itemArr['id'])) {
                        $prod = Product::find($itemArr['id']);
                        $imagePath = $prod?->image?->image ?? '';
                    }

                    $orderDetail = new OrderDetails;
                    $orderDetail->order_id = $order->id;
                    $orderDetail->product_id = $itemArr['id'] ?? 1;
                    $orderDetail->product_name = $itemArr['name'] ?? 'Product';
                    $orderDetail->purchase_price = $itemArr['purchase_price'] ?? 0;
                    $orderDetail->sale_price = $itemArr['price'] ?? 0;
                    $orderDetail->qty = (int) ($itemArr['qty'] ?? 1);
                    $orderDetail->product_size = $options['product_size'] ?? null;
                    $orderDetail->product_color = $options['product_color'] ?? null;
                    $orderDetail->product_image = $imagePath;
                    $orderDetail->save();

                    // Atomically decrement stock
                    if (! empty($itemArr['id'])) {
                        Product::where('id', $itemArr['id'])->decrement('stock', (int) ($itemArr['qty'] ?? 1));
                    }
                }

                $shipping = new Shipping;
                $shipping->order_id = $order->id;
                $shipping->customer_id = $customer->id;
                $shipping->name = $incomplete->name ?? 'Guest Buyer';
                $shipping->phone = $phone;
                $shipping->address = $incomplete->address ?? 'Bangladesh';
                $shipping->area = $shippingRecord ? $shippingRecord->name : 'Inside Dhaka';
                $shipping->save();

                $payment = new Payment;
                $payment->order_id = $order->id;
                $payment->customer_id = $customer->id;
                $payment->payment_method = 'Cash On Delivery';
                $payment->amount = $totalAmount;
                $payment->payment_status = 'pending';
                $payment->save();

                $incomplete->delete();

                // Record outbox event atomically within transaction (Rule 11)
                if (class_exists(OutboxService::class)) {
                    app(OutboxService::class)->record('order.created', [
                        'order_id' => $order->id,
                        'invoice_id' => $order->invoice_id,
                        'customer_id' => $order->customer_id,
                        'amount' => $order->amount,
                    ]);
                }

                return $order;
            });

            // Dispatch domain event outside transaction with safe error suppression
            try {
                event(new OrderPlaced($order));
            } catch (\Throwable $eventException) {
                Log::warning('OrderPlaced event listener error during incomplete order conversion: '.$eventException->getMessage(), [
                    'order_id' => $order->id,
                ]);
            }

            Toastr::success("Lead converted successfully into Order #{$order->invoice_id}!", 'Success');

            return redirect()->route('admin.orders', 'pending');
        } catch (\Throwable $e) {
            Log::error('Failed to convert abandoned cart lead #'.$id.': '.$e->getMessage(), [
                'trace' => $e->getTraceAsString(),
            ]);
            Toastr::error('Failed to convert abandoned cart: '.$e->getMessage(), 'Error');

            return redirect()->back();
        }
    }

