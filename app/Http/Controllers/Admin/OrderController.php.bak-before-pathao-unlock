    public function order_pathao(Request $request)
    {
        $orders_id = (array) $request->input('order_ids', []);
        if (empty($orders_id)) {
            return response()->json(['status' => 'failed', 'message' => 'No orders selected.'], 422);
        }

        $pathao_info = Courierapi::where(['status' => 1, 'type' => 'pathao'])->select('id', 'type', 'url', 'token', 'status')->first();
        if (! $pathao_info) {
            return response()->json(['status' => 'failed', 'message' => 'Pathao API configuration not found or disabled.'], 404);
        }

        $successCount = 0;
        $failedCount = 0;
        $lastErrorMessage = '';

        // Automatically use the first Pathao store.
        // No Store/City/Zone/Area selection is required.
        $storeResponse = Http::withHeaders([
            'Authorization' => 'Bearer '.$pathao_info->token,
            'Accept' => 'application/json',
            'Content-Type' => 'application/json',
        ])->timeout(15)->get(rtrim($pathao_info->url, '/').'/aladdin/api/v1/stores');

        $storeData = $storeResponse->json();
        $storeId = data_get($storeData, 'data.data.0.store_id');

        if (! $storeId) {
            return response()->json([
                'status' => 'failed',
                'message' => 'No Pathao store found. Please check your Pathao merchant account.'
            ], 422);
        }

        foreach ($orders_id as $order_id) {
            $order = Order::with('shipping')->find($order_id);
            if (! $order || (int) $order->order_status === (int) OrderStatusEnum::Delivered->value) {
                continue;
            }

            $itemQuantity = (int) OrderDetails::where('order_id', $order->id)->sum('qty');
            if ($itemQuantity < 1) {
                $itemQuantity = 1;
            }

            $recipientName = $order->shipping ? $order->shipping->name : 'Customer';
            $recipientPhone = $order->shipping ? $order->shipping->phone : '01700000000';
            $recipientAddress = $order->shipping ? $order->shipping->address : 'Dhaka';

            try {
                // Pathao now auto-detects City / Zone / Area from the full recipient address.
                // No City / Zone / Area / Store dropdown is required from the order page.
                $storeResponse = Http::withHeaders([
                    'Authorization' => 'Bearer '.$pathao_info->token,
                    'Accept' => 'application/json',
                    'Content-Type' => 'application/json',
                ])->timeout(15)->get(rtrim($pathao_info->url, '/').'/aladdin/api/v1/stores');

                $storeData = $storeResponse->json();
                $storeId = data_get($storeData, 'data.data.0.store_id');

                if (empty($storeId)) {
                    throw new \RuntimeException('No active Pathao store found.');
                }

                $response = Http::withHeaders([
                    'Authorization' => 'Bearer '.$pathao_info->token,
                    'Accept' => 'application/json',
                    'Content-Type' => 'application/json',
                ])->timeout(15)->post(rtrim($pathao_info->url, '/').'/aladdin/api/v1/orders', [
                    'store_id' => (int) $storeId,
                    'merchant_order_id' => (string) $order->invoice_id,
                    'recipient_name' => $recipientName,
                    'recipient_phone' => $recipientPhone,
                    'recipient_address' => $recipientAddress,
                    'delivery_type' => 48,
                    'item_type' => 2,
                    'special_instruction' => 'Special note- product must be checked after delivery',
                    'item_quantity' => $itemQuantity,
                    'item_weight' => 0.5,
                    'amount_to_collect' => round((float) $order->amount, 2),
                    'item_description' => 'Parcel order #'.$order->invoice_id,
                ]);

                $responseData = $response->json();

                if ($response->successful() && isset($responseData['data']['consignment_id'])) {
                    $courierStatusId = OrderStatus::whereIn('slug', ['in-courier', 'shipped', 'on-the-way'])->value('id') ?? OrderStatusEnum::Shipped->value;
                    $order->order_status = $courierStatusId;
                    $order->consignment_id = $responseData['data']['consignment_id'];

                    $order->save();
                    $successCount++;
                } else {
                    $failedCount++;
                    $lastErrorMessage = $responseData['message'] ?? 'Pathao booking rejected';
                }
            } catch (\Throwable $e) {
                $failedCount++;
                $lastErrorMessage = $e->getMessage();
            }
        }

        $status = $successCount > 0 ? 'success' : 'failed';
        $message = $successCount > 0
            ? "Successfully dispatched {$successCount} order(s) to Pathao.".($failedCount > 0 ? " ({$failedCount} failed: {$lastErrorMessage})" : '')
            : 'Failed to dispatch orders to Pathao: '.($lastErrorMessage ?: 'Unknown error');

        if ($successCount > 0) {
            Toastr::success($message, 'Pathao Courier');
        } else {
            Toastr::error($message, 'Pathao Courier');
        }

        return response()->json([
            'status' => $status,
            'message' => $message,
            'success_count' => $successCount,
            'failed_count' => $failedCount,
        ]);
    }

