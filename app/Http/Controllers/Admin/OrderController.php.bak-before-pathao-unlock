    public function order_status(Request $request)
    {
        $order_ids = $request->input('order_ids', []);
        if (empty($order_ids)) {
            return response()->json(['status' => 'error', 'message' => 'Please select at least one order.'], 422);
        }

        $newStatus = (int) $request->order_status;
        $orders = Order::whereIn('id', $order_ids)->get();

        $updatedCount = 0;
        $skippedCount = 0;

        foreach ($orders as $order) {
            if ($order->isCourierDispatched()) {
                $skippedCount++;

                continue;
            }

            $oldStatus = (int) $order->order_status;
            $order->order_status = $newStatus;
            $order->save();
            $this->syncStockAndPaymentOnStatusChange($order, $oldStatus, $newStatus);
            $updatedCount++;
        }

        if ($updatedCount === 0 && $skippedCount > 0) {
            return response()->json([
                'status' => 'error',
                'message' => 'Selected order(s) are dispatched to courier and cannot be changed manually.',
            ], 422);
        }

        $message = "Order status changed for {$updatedCount} order(s).";
        if ($skippedCount > 0) {
            $message .= " ({$skippedCount} courier-managed order(s) skipped)";
        }

        return response()->json(['status' => 'success', 'message' => $message]);
    }

