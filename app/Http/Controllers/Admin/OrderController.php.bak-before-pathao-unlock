    public function product_search(Request $request)
    {
        $q = trim($request->get('q', $request->get('keyword', '')));
        if (empty($q)) {
            return response()->json(['products' => []]);
        }

        $products = Product::where('status', 1)
            ->where(function ($query) use ($q) {
                $query->where('name', 'LIKE', "%{$q}%")
                    ->orWhere('product_code', $q)
                    ->orWhere('product_code', 'LIKE', "%{$q}%")
                    ->orWhere('pro_barcode', $q)
                    ->orWhere('pro_barcode', 'LIKE', "%{$q}%")
                    ->orWhere('id', $q);
            })
            ->with('image')
            ->limit(20)
            ->get()
            ->map(function ($p) {
                return [
                    'id' => $p->id,
                    'name' => $p->name,
                    'new_price' => (float) $p->new_price,
                    'stock' => (int) ($p->stock ?? 0),
                    'product_code' => $p->product_code ?? '',
                    'image' => $p->image ? asset($p->image->image) : '',
                ];
            });

        $exactMatch = $products->first(function ($p) use ($q) {
            return strtolower($p['product_code']) === strtolower($q) || (string) $p['id'] === $q;
        });

        return response()->json([
            'products' => $products,
            'exact_match' => $exactMatch ? true : false,
            'matched_product' => $exactMatch,
        ]);
    }

    public function order_store(AdminOrderStoreRequest $request)
    {
        if (CartService::instance('pos_shopping')->count() <= 0) {
            Toastr::error('Your shopping empty', 'Failed!');

            return redirect()->back();
        }

        $order = DB::transaction(function () use ($request) {
            $subtotal = CartService::instance('pos_shopping')->subtotal();
            $subtotal = (float) str_replace([',', '.00'], '', $subtotal);
            $discount = (float) (Session::get('pos_discount', 0) + Session::get('product_discount', 0));
            $shippingfee = ShippingCharge::find($request->area);
            $shippingAmount = $shippingfee ? (float) $shippingfee->amount : 0;
            $areaName = $shippingfee ? $shippingfee->name : 'Inside Dhaka';

            $customer = Customer::where('phone', $request->phone)->first();
            if (! $customer) {
                $autoPassword = (string) rand(111111, 999999);
                $customer = new Customer;
                $customer->name = $request->name;
                $customer->slug = Str::slug($request->name).'-'.rand(100, 999);
                $customer->phone = $request->phone;
                $customer->password = bcrypt($autoPassword);
                $customer->verify = 1;
                $customer->status = 1;
                $customer->save();
                SmsGateway::sendAutoGeneratedPasswordSms($customer, $autoPassword);
            }

            // 1. Order record
            $order = new Order;
            $order->invoice_id = rand(11111, 99999);
            $order->amount = max(0, ($subtotal + $shippingAmount) - $discount);
            $order->discount = $discount;
            $order->shipping_charge = $shippingAmount;
            $order->customer_id = $customer->id;
            $order->order_status = OrderStatusEnum::Pending->value;
            $order->note = $request->note;
            $order->save();

            // 2. Shipping record
            $shipping = new Shipping;
            $shipping->order_id = $order->id;
            $shipping->customer_id = $customer->id;
            $shipping->name = $request->name;
            $shipping->phone = $request->phone;
            $shipping->address = $request->address;
            $shipping->area = $areaName;
            $shipping->save();

            // 3. Payment record
            $payment = new Payment;
            $payment->order_id = $order->id;
            $payment->customer_id = $customer->id;
            $payment->payment_method = 'Cash On Delivery';
            $payment->amount = $order->amount;
            $payment->payment_status = PaymentStatusEnum::Pending->value;
            $payment->save();

            // 4. Order details records & stock reduction
            foreach (CartService::instance('pos_shopping')->content() as $cart) {
                $orderDetails = new OrderDetails;
                $orderDetails->order_id = $order->id;
                $orderDetails->product_id = $cart->id;
                $orderDetails->product_name = $cart->name;
                $orderDetails->purchase_price = $cart->options->purchase_price ?? 0;
                $orderDetails->product_discount = $cart->options->product_discount ?? 0;
                $orderDetails->product_size = $cart->options->product_size ?? null;
                $orderDetails->product_color = $cart->options->product_color ?? null;
                $orderDetails->sale_price = $cart->price;
                $orderDetails->qty = $cart->qty;
                $orderDetails->save();

                // Atomically decrement stock
                Product::where('id', $cart->id)->decrement('stock', $cart->qty);
            }

            return $order;
        });

        CartService::instance('pos_shopping')->destroy();
        Session::forget('pos_shipping');
        Session::forget('pos_discount');
        Session::forget('product_discount');

        event(new OrderPlaced($order));

        Toastr::success('Thanks, Your order placed successfully', 'Success!');

        return redirect('admin/order/pending');
    }

